(println)
;/
(println "")
;/
(println "abc")
;/abc
(println "abc  def" "ghi jkl")
;/abc  def ghi jkl
(println "\"")
;/"
(println "abc\ndef\nghi")
;/abc
(println "abc\\def\\ghi")
;/abc\\def\\ghi
(println (list 1 2 "abc" "\"") "def")
;/\(1 2 abc "\) def
(= :abc :abc)
;=>true
(= :abc :def)
;=>false
(= :abc ":abc")
;=>false
(= (list :abc) (list :abc))
;=>true
(if [] 7 8)
;=>7
(pr-str [1 2 "abc" "\""] "def")
;=>"[1 2 \"abc\" \"\\\"\"] \"def\""
(pr-str [])
;=>"[]"
(str [1 2 "abc" "\""] "def")
;=>"[1 2 abc \"]def"
(str [])
;=>"[]"
(count [1 2 3])
;=>3
(empty? [1 2 3])
;=>false
(empty? [])
;=>true
(list? [4 5 6])
;=>false
(= [] (list))
;=>true
(= [7 8] [7 8])
;=>true
(= [:abc] [:abc])
;=>true
(= (list 1 2) [1 2])
;=>true
(= (list 1) [])
;=>false
(= [] [1])
;=>false
(= 0 [])
;=>false
(= [] 0)
;=>false
(= [] "")
;=>false
(= "" [])
;=>false
( (fn* [] 4) )
;=>4
( (fn* [f x] (f x)) (fn* [a] (+ 1 a)) 7)
;=>8
(= [(list)] (list []))
;=>true
(= [1 2 (list 3 4 [5 6])] (list 1 2 [3 4 (list 5 6)]))
;=>true
