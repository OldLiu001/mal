#!/bin/csh -f
# mal (Make a Lisp) - csh implementation runner
# STEP env selects the step file (default stepA_mal); remaining args forwarded.
# The implementation resolves test-relative paths ("../tests/...") from its
# own directory, so cd there first.
set step = "$STEP"
if ("$step" == "") set step = "stepA_mal"
set dir = `dirname $0`
cd "$dir"
exec /bin/csh "$step.csh" $argv
